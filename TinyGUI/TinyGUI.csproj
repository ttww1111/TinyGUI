<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>TinyGUI</AssemblyName>
    <RootNamespace>TinyGUI</RootNamespace>
    <ApplicationIcon>Images\panda.ico</ApplicationIcon>
    <!-- 单一版本源：程序集版本 / 文件版本 / 信息版本都从这里出。
         改版本只动这一行；UI 与安装包脚本都会自动同步。 -->
    <Version>1.2.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tinify" Version="1.9.0" />
    <!-- net48 编译引用包：免装 .NET Framework 4.8 Dev Pack 也能用 .NET 8 SDK 编 net48 -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- 字体：仅保留实际用到的字重，去掉 17 个 JetBrainsMono 变体的臃肿 -->
    <Resource Include="Fonts\JetBrainsMono\JetBrainsMono-Regular.ttf" />
    <Resource Include="Fonts\JetBrainsMono\JetBrainsMono-Bold.ttf" />
    <Resource Include="Fonts\segoe.ttf" />
    <Resource Include="Fonts\Font Awesome 6 Pro-Solid-900.otf" />
  </ItemGroup>

  <ItemGroup>
    <!-- 图片作为 Content 复制到输出目录，供 XAML 以 /Images/... 相对路径引用。
         Images/scale/*.png 经核查未被任何 XAML 引用（智能裁切用的是绘制的 Rectangle），已从源码删除。 -->
    <Content Include="Images\panda.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Images\TinyGUI.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
