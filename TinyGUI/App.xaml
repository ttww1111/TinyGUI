<Application x:Class="TinyGUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TinyGUI"
             xmlns:conv="clr-namespace:TinyGUI.Converters"
             StartupUri="Views/MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles/Fonts.xaml" />
        <ResourceDictionary Source="Styles/Button.xaml" />
        <ResourceDictionary Source="Styles/ComboBoxStyle.xaml" />
        <ResourceDictionary Source="Styles/ScrollViewer.xaml" />
        <ResourceDictionary Source="Styles/TextBox.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
      <conv:EmptyToVisibilityConverter x:Key="EmptyToVisibilityConverter" />
      <conv:IntEqualsConverter x:Key="IntEqualsConverter" />
      <conv:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />

      <!-- 悬停气泡全局样式：白底圆角 + 轻阴影 -->
      <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#E2E8F0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Foreground" Value="#5A6573" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToolTip}">
              <Border Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="8" Padding="{TemplateBinding Padding}">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.22" Color="#000000" />
                </Border.Effect>
                <ContentPresenter />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
